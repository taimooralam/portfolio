# Environment Variables Example
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control

# Application Information
VITE_APP_TITLE=Technical Lead Portfolio
VITE_APP_DESCRIPTION=Professional technical lead portfolio website
VITE_APP_VERSION=1.0.0

# Contact Information
VITE_CONTACT_EMAIL=your.email@domain.com
VITE_CONTACT_PHONE=+1-234-567-8900
VITE_CONTACT_LOCATION=Your City, Country

# Social Links
VITE_LINKEDIN_URL=https://linkedin.com/in/yourprofile
VITE_GITHUB_URL=https://github.com/yourusername
VITE_TWITTER_URL=https://twitter.com/yourusername
VITE_PORTFOLIO_URL=https://yourdomain.com

# Analytics and Monitoring (Optional)
VITE_GA_TRACKING_ID=GA_MEASUREMENT_ID
VITE_SENTRY_DSN=SENTRY_PROJECT_DSN
VITE_HOTJAR_ID=HOTJAR_SITE_ID

# Contact Form Integration (Optional)
VITE_FORMSPREE_ENDPOINT=your_formspree_endpoint
VITE_NETLIFY_FORM_NAME=contact-form
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# API Keys (Optional - for future integrations)
VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_KEY=your_api_key_here

# Build Configuration
NODE_ENV=development